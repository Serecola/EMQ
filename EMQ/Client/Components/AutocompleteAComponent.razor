@using EMQ.Shared.Library.Entities.Concrete
@inject HttpClient _client

<MyAutocompleteComponent @ref="AutocompleteComponent"
                         TValue="AutocompleteA"
                         MaxMenuHeight="325px"
                         HighlightMatch="true"
                         RequireConfirmation="false"
                         ShowIcons="true"
                         IsTypingNoDropdown="@(IsQuizPage && ClientState.IsTypingNoDropdown)"
                         UsePreferences="false"
                         Disabled="IsDisabled"
                         Placeholder="@Placeholder"
                         GuessStr="@(Guess == null ? "" : $"{Guess.AALatinAlias}")"
                         TextField="@((item) => $"{item.AALatinAlias}{(!string.IsNullOrWhiteSpace(item.AANonLatinAlias) ? $" ({item.AANonLatinAlias})" : "")}")"
                         TextFieldForSelectedText="@(item => item.AALatinAlias)"
                         IconField="@(x => OnIconField(x))"
                         OnSearch="@(x => OnSearch<AutocompleteA>(x))"
                         OnValueChanged="OnValueChanged"/>
