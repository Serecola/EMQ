# Inline comments are NOT supported.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/EMQ
EMQ_AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/EMQ_AUTH
EMQ_VNDB_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vndbforemq

# no trailing /
EMQ_SELFHOST_ADDRESS=https://example.com

EMQ_SMTP_HOST=smtp.example.com
EMQ_SMTP_PASSWORD=hunter2
EMQ_SMTP_PORT=587
EMQ_SMTP_USERNAME=username@example.com

EMQ_SFTP_HOST=
EMQ_SFTP_USERNAME=
EMQ_SFTP_PASSWORD=
EMQ_SFTP_USER_UPLOAD_DIR=

# sftp (default, production) or local (store uploads on local disk, useful for development)
# no trailing /
EMQ_STORAGE_MODE=sftp

# local upload storage root, only used when EMQ_STORAGE_MODE=local
# no trailing /
EMQ_LOCAL_STORAGE_DIR=

# optional override: nekobako files go here instead of EMQ_LOCAL_STORAGE_DIR/userup/nekobako
# no trailing /
EMQ_LOCAL_NEKOBAKO_DIR=

# VNDB image export (https://vndb.org/d14) with cv/, sf/, ch/ subdirs,
# served at /selfhoststorage/vndb-img/, only used when EMQ_STORAGE_MODE=local
# no trailing /
EMQ_LOCAL_VNDBIMG_DIR=
